# 允许这两个包运行安装脚本（esbuild 需要下载平台二进制，electron 需要下载运行时）。
# 若不显式允许，pnpm 会忽略其构建脚本，并在 verify-deps-before-run 检查中报错。
# 与 package.json 的 pnpm.onlyBuiltDependencies 保持一致。
only-built-dependencies[]=esbuild
only-built-dependencies[]=electron

# 运行脚本前不强制做依赖状态校验：本项目的依赖已装好，
# 该校验会在构建脚本被忽略时直接让 `pnpm run build` 失败。
verify-deps-before-run=false
